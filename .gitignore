# ========================================================
# Food Delivery Super Admin - Comprehensive .gitignore
# ========================================================

# --- Frontend Exclusions ---
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment and Secrets ---
.env
.env.local
.env.development
.env.production
.env.*.local
*.env
**/.env
**/.env.*
!**/.env.example
secrets/
**/secrets/
credentials/
**/credentials/
*.pem
*.key
*.p12
*.jks

# --- Backend Exclusions ---
target/
**/target/
*.class
**/*.class
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- IDE & Editor Files ---
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
**/*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# --- Local Database, Temporary & Archive Files ---
*.log
**/*.log
*.db
*.sqlite
*.sqlite3
*.zip
*.tar.gz
*.rar
uploads/
**/uploads/
.DS_Store
Thumbs.db
